# Copy to .env on the NAS. Never commit the filled file.
# Pin a sha-<full commit SHA> or release tag after checking the CI run.
CUCHI_IMAGE_TAG=main
CUCHI_BIND_ADDRESS=127.0.0.1
CUCHI_PORT=8080
CUCHI_PUBLIC_URL=https://vpn.example.com
# Generate with: openssl rand -hex 32 (URL-safe password for the DB URL)
POSTGRES_PASSWORD=replace-with-random-hex
# Generate ONCE with: openssl rand -base64 32
# Back up separately; changing this key makes stored secrets unreadable.
CUCHI_MASTER_KEY=
# Use the exact issuer returned by Synology's OIDC discovery document.
CUCHI_OIDC_ISSUER=https://sso.example.com/webman/sso
CUCHI_OIDC_CLIENT_ID=
CUCHI_OIDC_CLIENT_SECRET=
CUCHI_ADMIN_GROUP=administrators
CUCHI_USER_GROUP=vpn-users

# Only for compose.npm.yaml: existing Docker network used by your reverse proxy.
CUCHI_PROXY_NETWORK=proxy
